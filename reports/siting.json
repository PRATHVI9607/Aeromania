    "src": "assumption: usable share of land-cover class (60 bare, 30 grass, 20 shrub, 40 cropland); cropland is low because buying farmland is slow and costly"
   },
   "max_slope_deg": {
    "v": 5,
    "src": "assumption: ground-mount PV rule of thumb, flat to gentle terrain"
   },
   "ha_per_mw": {
    "v": 1.8,
    "lo": 1.6,
    "hi": 2.0,
    "src": "assumption: brief range 1.6-2.0 ha/MW for Indian utility PV. Cross-check: Pavagada 13,000 acres / 2,050 MW = 2.57 ha/MW gross incl. roads and substations (https://en.wikipedia.org/wiki/Pavagada_Solar_Park, 2024)"
   },
   "pr": {
    "v": 0.77,
    "src": "assumption: performance ratio, brief; typical 0.75-0.80"
   },
   "cuf_formula": "CUF = GHI[kWh/m2/day] * 365 * PR / 8760 per kWp at 1 kW/m2 STC (DC basis, no inverter clipping or degradation)",
   "tariff_rs_kwh": {
    "v": 2.6,
    "src": "assumption: SECI standalone ISTS solar tranches ~Rs 2.57-2.60/kWh (https://www.constructionworld.in/energy-infrastructure/power-and-renewable-energy/cerc-approves-tariff-for-secis-1.2-gw-solar-projects/70290 , 2025). Solar+storage auctions are higher (Rs 2.86, https://www.pv-magazine.com/2025/10/16/indias-solar-plus-storage-tender-sets-record-low-inr-2-86-tariff/ , Oct 2025) and are not used"
   },
   "capex_cr_per_mw": {
    "v": 3.7,
    "lo": 3.1,
    "hi": 4.2,
    "src": "Government of India stated Rs 3.5-4 crore/MW utility solar (Sept 2025, as cited in https://avaadaelectro.com/blog/solar-power-plant-setup-cost-india/ ); examples Rs 3.82 cr/MW UP 209 MW (Oct 2025) and Rs 3.5 cr/MW SJVN Rajasthan 100 MW (Jan 2025); UERC benchmark Rs 3.08 cr/MW from 1 Apr 2025 (low case, https://cdnbbsr.s3waas.gov.in/s3cf05968255451bdefe3c5bc64d550517/uploads/2025/06/202506131910199470.pdf); LinkedIn 2025 EPC range Rs 3.1-4.2 cr/MW (high case). Base 3.7 = mid of government range. Not tuned to results. Excludes land. Capex is per MW DC (CUF is DC basis)"
   },
   "om_lakh_per_mw_yr": {
    "v": 4.0,
    "src": "assumption: ~Rs 4 lakh/MW/yr O&M, unverified"
   },
   "grid_cr_per_km": {
    "v": 0.8,
    "src": "assumption: ~Rs 0.8 crore/km for a 66-132 kV evacuation line, unverified; charged once per cell on distance to nearest substation"
   },
   "min_project_mw": {
    "v": 20,
    "src": "assumption: cells below 20 MW usable are not ranked (too small for a utility project alone)"
   },
   "wacc": {
    "v": 0.095,
    "src": "assumption: WACC 9-10% (mid 9.5%) typical for Indian utility RE debt+equity, not verified against a single document"
   },
   "life_yr": {
    "v": 25,
    "src": "assumption: 25-year project life, standard PPA term. CRF = w/(1-(1+w)^-n) = 0.106"
   }
